{
  "name": "ptify-frontend",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k \"cd .. && cross-env PTIFY_DB_PATH=var/ptify.db PTIFY_JWT_SECRET=dev-secret python -m uvicorn api.app:create_app --factory\" \"vite --host 0.0.0.0\"",
    "restart:all": "npm run dev:all",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:browser": "node tests/browser/run.mjs",
    "test:fixtures": "node tests/browser/fixtures.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smplr": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
