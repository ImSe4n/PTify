# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
build/
eggs/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
venv/
env/
ENV/
.venv/

# Model weights — large binaries, downloaded on first run.
# See README: these are NOT committed.
*.pth
*.pt
*.ckpt
*.onnx
models/
checkpoints/

# PyInstaller
*.manifest
*.spec
build/
dist/

# Audio scratch / recordings captured during testing
*.wav
*.mp3
*.flac
*.ogg
*.aiff
recordings/
scratch/

# MIDI output from transcription runs (keep sample songs in assets/ if needed)
out/
*.out.mid

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# NOTE: tests/ is deliberately TRACKED. The suite pins the regressions found
# in the Phase 12 audit (merge destroying trills, O(n^2) harmonic filter,
# count-only verification), so it has to travel with the code.
.pytest_cache/

# NOTE: HANDOFF.md is deliberately TRACKED as of Phase 13. It is the working
# brief the agreement says to update every phase, so a fresh clone that got
# HISTORY.md without it was missing half the context.

# Real-audio benchmark corpus (Phase 13).
# MAESTRO is CC BY-NC-SA 4.0 and this repo is MIT, so NO corpus audio or MIDI
# is ever committed. The corpus is reconstructed from benchmarks/*.json, which
# records the track list and a sha256 per file. *.wav is already ignored
# above; *.midi is NOT, and the fetcher writes .midi deliberately.
*.midi
recordings/
# Cached MAESTRO metadata (~300KB, re-fetched on demand). The manifest records
# its sha256, so the cache itself does not need to be committed.
benchmarks/.maestro-metadata.csv
